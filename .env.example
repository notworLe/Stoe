# PostgreSQL Configuration (copy to .env and fill real local values)
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password
POSTGRES_DB=stoe
DATABASE_URL=postgresql+psycopg://your_pg_user:your_pg_password@localhost:5432/stoe

# Backend Admin & Security
ADMIN_EMAIL=admin@maisondelua.com.au
ADMIN_PASSWORD=change_this_admin_password
JWT_SECRET=change_this_random_secret_min_32_chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional SMTP Email Configuration (for live Invoice Emails)
# Leave SMTP_HOST blank to use built-in simulated email logging & preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@maisondelua.com.au

# Frontend API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://localhost:8000
